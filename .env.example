# Copy to .env and fill in. Secrets live only in the orchestrator's environment.

# Gemini (called directly, not through Agent37's router)
GEMINI_API_KEY=
GEMINI_PLAN_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768

# Nimble (https://sdk.nimbleway.com)
NIMBLE_API_KEY=
NIMBLE_CONCURRENCY=4

# Agent37 (sk_live_ key is effectively root on every instance; never ship it to a worker)
AGENT37_API_KEY=
# Comma-separated worker instance ids, created with scripts/create_workers.py
AGENT37_WORKERS=
AGENT37_SESSIONS_PER_WORKER=2

# Orchestrator
PIP_HOST=127.0.0.1
PIP_PORT=8765
# Random token the overlay must present on connect. Generated on first run if empty.
PIP_TOKEN=
PIP_DB_PATH=data/pip.db
# Global daily spend cap across Gemini, Nimble, and workers
PIP_DAILY_CAP_USD=10
# Set to 1 to stop dispatching anything that costs money
PIP_KILL_SWITCH=0
